{
  "productName": "QuotaDesktop",
  "mainBinaryName": "quota-desktop",
  "version": "0.1.0",
  "identifier": "com.tokengateway.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": null,
      "dangerousDisableAssetCspModification": true
    }
  }
}
